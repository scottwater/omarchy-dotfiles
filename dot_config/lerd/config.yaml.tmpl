    extensions:
        - imap
    packages:
        - bash
    realised:
        "8.3":
            hash: 6a1db9e00b23d59714d4cd24f6f7f96844ecc8910797fed3149e2a0cfd1dca85
            extensions:
                - imap
            packages:
                - bash
node:
    default_version: "22"
    managed: false
    manager: fnm
nginx:
    http_port: 80
    https_port: 443
dns:
    enabled: true
    tld: test
notifications:
