        enabled: true
        image: docker.io/axllent/mailpit:latest
        port: 1025
        extra_ports: []
    meilisearch:
        enabled: true
        image: ""
        port: 7700
        extra_ports: []
    mysql:
        enabled: true
        image: ""
        port: 3306
        extra_ports: []
        canonical_version: "8.4"
    postgres:
        enabled: true
        image: ""
        port: 5432
        extra_ports: []
    redis:
        enabled: true
        image: ""
        port: 6379
        extra_ports: []
    rustfs:
        enabled: true
        image: docker.io/rustfs/rustfs:latest
        port: 9000
        extra_ports: []
